{
  "name": "adiutor",
  "productName": "Adiutor",
  "version": "1.2.0",
  "private": true,
  "description": "Local-first desktop code editor with an AI agent task graph (planner, coder, reviewer), explicit diff approvals and support for OpenAI, Claude, DeepSeek and Grok.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fraisensenpai/Adiutor.git"
  },
  "homepage": "https://github.com/fraisensenpai/Adiutor#readme",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "electron",
    "code-editor",
    "ai-agents",
    "local-first",
    "monaco",
    "tree-sitter",
    "typescript"
  ],
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win portable",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "node-sqlite3-wasm": "0.8.61",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
